{
  "name": "vcpkg-cmake-feature-selector",
  "displayName": "vcpkg CMake Feature Selector",
  "description": "Select vcpkg manifest features for CMake-based workspaces.",
  "icon": "images/icon.png",
  "version": "0.1.2",
  "publisher": "TheRealShoxie",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TheRealShoxie/Vcpkg-Feature-Selector.git"
  },
  "homepage": "https://github.com/TheRealShoxie/Vcpkg-Feature-Selector#readme",
  "bugs": {
    "url": "https://github.com/TheRealShoxie/Vcpkg-Feature-Selector/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vcpkg",
    "cmake",
    "dependencies",
    "manifest",
    "features"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vcpkgFeatureSelector.selectFeatures",
        "title": "vcpkg: Select Manifest Features"
      },
      {
        "command": "vcpkgFeatureSelector.getSelectedFeatures",
        "title": "vcpkg: Get Selected Manifest Features"
      }
    ],
    "configuration": {
      "title": "vcpkg CMake Feature Selector",
      "properties": {
        "vcpkgFeatureSelector.environmentFeatures": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "vcpkg manifest features applied when the extension starts in this environment. Use 'none' for no optional features and separate multiple features with ';'. Leave empty to preserve the existing selection."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "vcpkgFeatureSelector.getSelectedFeatures",
          "when": "false"
        }
      ]
    }
  },
  "main": "./src/extension.js",
  "extensionDependencies": [
    "ms-vscode.cmake-tools"
  ],
  "activationEvents": [
    "workspaceContains:vcpkg.json",
    "onCommand:vcpkgFeatureSelector.getSelectedFeatures"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:syntax": "node --check src/featureState.js && node --check src/extension.js",
    "test:all": "npm run test:syntax && npm test",
    "package:vsix": "npx @vscode/vsce package --readme-path README.marketplace.md"
  },
  "extensionKind": [
    "workspace"
  ]
}
